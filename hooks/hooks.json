{
  "description": "Blocks reads and writes to stored memory while a session is in incognito mode",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/core/incognito.sh guard --format=claude", "timeout": 5, "statusMessage": "incognito guard" }
        ]
      }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/core/incognito.sh cleanup --format=claude", "timeout": 5 } ] }
    ]
  }
}
